# Copy to secrets.yaml (never commit it) and fill in on your own machine.
# Discord: #network-admin-alerts → Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL
discord_webhook: "https://discord.com/api/webhooks/REPLACE/ME"
# Uptime Kuma: Add New Monitor → type "Push" → name "homelab-watchdog", heartbeat 120 s → copy the Push URL
# (paste it WITHOUT the ?status=up&msg=OK&ping= part)
kuma_push_url: "http://192.168.8.149:3001/api/push/REPLACE"
# any long random string; ESPHome asks for it on every OTA update
ota_password: "REPLACE-with-a-long-random-string"
# web UI login (user "admin"); Infisical /homelab-watchdog WEB_PASSWORD
web_password: "REPLACE-with-a-long-random-string"
